    <div>
        <h4 style="margin:0; color:#fff; font-size:15px;">Shirin buyurtma qabul qilindi!</h4>
        <p style="margin:3px 0 0 0; color:#94a3b8; font-size:12px;">Xaridingiz tez orada tayyor bo'ladi.</p>
    </div>
</div>

<script>
    let selectedItemsBucket = {};

    function toggleMultiSelect(cardElement) {
        const itemId = cardElement.getAttribute('data-id');
        const itemName = cardElement.getAttribute('data-name');
        const itemPrice = parseInt(cardElement.getAttribute('data-price'));

        if (cardElement.classList.contains('multi-selected')) {
            cardElement.classList.remove('multi-selected');
            delete selectedItemsBucket[itemId];
        } else {
            cardElement.classList.add('multi-selected');
            selectedItemsBucket[itemId] = { name: itemName, price: itemPrice };
        }

        renderLiveBasketAndTotal();
    }

    function renderLiveBasketAndTotal() {
        const name = document.getElementById('client-name').value || "Mijoz";
        const phone = document.getElementById('client-phone').value.trim();
        
        document.getElementById('chk-name').textContent = name;
        
        const phoneReceipt = document.getElementById('chk-phone');
        if (phone.length > 0) {
            phoneReceipt.textContent = phone;
            phoneReceipt.style.color = "#000";
            document.getElementById('client-phone').classList.remove('error-active');
        } else {
            phoneReceipt.textContent = "Kiritilmagan";
            phoneReceipt.style.color = "var(--error)";
        }

        const basketListContainer = document.getElementById('receipt-basket-list');
        basketListContainer.innerHTML = "";

        let grandTotal = 0;
        let itemKeys = Object.keys(selectedItemsBucket);

        if (itemKeys.length === 0) {
            basketListContainer.innerHTML = `<div style="color:#777; text-align:center; font-size:11px; margin-top:20px;">Mahsulot tanlanmadi</div>`;
        } else {
            itemKeys.forEach(key => {
                const item = selectedItemsBucket[key];
                grandTotal += item.price;

                const row = document.createElement('div');
                row.className = 'bucket-row';
                row.innerHTML = `<span>• ${item.name}</span> <span>${item.price.toLocaleString()} so'm</span>`;
                basketListContainer.appendChild(row);
            });
        }

        document.getElementById('chk-grand-total').textContent = "JAMI: " + grandTotal.toLocaleString() + " so'm";
    }

    document.getElementById('client-name').addEventListener('input', renderLiveBasketAndTotal);
    document.getElementById('client-phone').addEventListener('input', renderLiveBasketAndTotal);

    let systemSmsCode = 0;
    function verifyAndSendOrder() {
        const phoneValue = document.getElementById('client-phone').value.trim();
        const itemKeys = Object.keys(selectedItemsBucket);

        if (itemKeys.length === 0) {
            alert("❌ Kamida bitta mahsulot tanlashingiz kerak!");
            return;
        }

        if (phoneValue === "" || phoneValue.length < 5) {
            document.getElementById('client-phone').classList.add('error-active');
            alert("❌ Buyurtma berish uchun telefon raqamingiz shart!");
            document.getElementById('client-phone').focus();
            return;
        }

        systemSmsCode = Math.floor(1000 + Math.random() * 9000);
        document.getElementById('generated-sms-field').textContent = systemSmsCode;
        document.getElementById('sms-user-input').value = "";
        document.getElementById('verification-modal').style.display = 'flex';
    }

    function submitSmsCodeVerification() {
        const userInput = document.getElementById('sms-user-input').value.trim();

        if (userInput == systemSmsCode) {
            document.getElementById('verification-modal').style.display = 'none';
            
            const toast = document.getElementById('toast-success-banner');
            toast.classList.add('active-toast');
            
            setTimeout(() => {
                toast.classList.remove('active-toast');
            }, 4000);

            selectedItemsBucket = {};
            document.querySelectorAll('.premium-choco-card').forEach(card => card.classList.remove('multi-selected'));
            renderLiveBasketAndTotal();

        } else {
            alert("❌ Tasdiqlash kodi xato! Qayta urinib ko'ring.");
        }
    }

    function executeClusterFilter(segment, btnElement) {
        document.querySelectorAll('.mini-filter-node').forEach(btn => btn.classList.remove('active-node'));
        btnElement.classList.add('active-node');

        document.querySelectorAll('.category-cluster').forEach(cluster => {
            if (cluster.getAttribute('data-segment') === segment) {
                cluster.style.display = 'block';
            } else {
                cluster.style.display = 'none';
            }
        });
    }

    function searchCatalogItems() {
        const query = document.getElementById('catalog-searcher').value.toLowerCase();
        document.querySelectorAll('.premium-choco-card').forEach(card => {
            const name = card.getAttribute('data-name').toLowerCase();
            card.style.display = name.includes(query) ? 'flex' : 'none';
        });
    }

    setInterval(() => {
        const d = new Date();
        let h = d.getHours(), m = d.getMinutes(), s = d.getSeconds();
        h = h < 10 ? '0' + h : h; m = m < 10 ? '0' + m : m; s = s < 10 ? '0' + s : s;
        document.getElementById('terminal-clock').textContent = h + ':' + m + ':' + s;
    }, 1000);
</script>

