<!-- TOAST -->
<div class="toast-slide-notification" id="toast-notify">
    <div style="font-size:24px;">✨</div>
    <div>
        <div style="font-weight:bold; font-size:14px; color:#fff;" id="toast-title">Bildirishnoma</div>
        <div style="font-size:12px; color:var(--text-dim);" id="toast-desc">Tafsilotlar...</div>
    </div>
</div>

<script>
    let activeCart = {};

    // Soat
    setInterval(() => {
        const now = new Date();
        document.getElementById('terminal-clock').innerText = now.toTimeString().split(' ')[0];
    }, 1000);

    // Ism va Familiyani birlashtirib chekda ko'rsatish
    function updateFullName() {
        const name = document.getElementById('client-name').value.trim();
        const surname = document.getElementById('client-surname').value.trim();
        const fullNameSpan = document.getElementById('chk-fullname');

        if (name || surname) {
            fullNameSpan.innerText = `${name} ${surname}`.trim();
            fullNameSpan.style.color = '#000';
        } else {
            fullNameSpan.innerText = 'Kiritilmagan';
            fullNameSpan.style.color = 'var(--error)';
        }
    }

    document.getElementById('client-name').addEventListener('input', (e) => {
        e.target.classList.remove('error-active');
        updateFullName();
    });

    document.getElementById('client-surname').addEventListener('input', (e) => {
        e.target.classList.remove('error-active');
        updateFullName();
    });

    document.getElementById('client-phone').addEventListener('input', (e) => {
        const val = e.target.value.trim();
        const phoneSpan = document.getElementById('chk-phone');
        e.target.classList.remove('error-active');
        if(val.length > 0) {
            phoneSpan.innerText = val;
            phoneSpan.style.color = 'var(--success)';
        } else {
            phoneSpan.innerText = 'Kiritilmagan';
            phoneSpan.style.color = 'var(--error)';
        }
    });

    document.getElementById('client-address').addEventListener('input', (e) => {
        const val = e.target.value.trim();
        const addressSpan = document.getElementById('chk-address');
        e.target.classList.remove('error-active');
        if(val.length > 0) {
            addressSpan.innerText = val;
            addressSpan.style.color = 'var(--deep-blue)';
        } else {
            addressSpan.innerText = 'Kiritilmagan';
            addressSpan.style.color = 'var(--error)';
        }
    });

    // Tanlash (Multi-select)
    function toggleMultiSelect(cardNode) {
        const id = cardNode.getAttribute('data-id');
        const name = cardNode.getAttribute('data-name');
        const price = parseInt(cardNode.getAttribute('data-price'));

        if(activeCart[id]) {
            delete activeCart[id];
            cardNode.classList.remove('multi-selected');
        } else {
            activeCart[id] = { name, price, count: 1 };
            cardNode.classList.add('multi-selected');
        }
        renderReceipt();
    }

    // Chekni chiqarish
    function renderReceipt() {
        const bucketContainer = document.getElementById('receipt-basket-list');
        bucketContainer.innerHTML = '';
        let grandTotal = 0;
        let keys = Object.keys(activeCart);

        if(keys.length === 0) {
            bucketContainer.innerHTML = '<div style="color:#777; text-align:center; font-size:11px; margin-top:20px;">Shirinlik tanlanmadi</div>';
            document.getElementById('chk-grand-total').innerText = "JAMI: 0 so'm";
            return;
        }

        keys.forEach(id => {
            let item = activeCart[id];
            let rowTotal = item.price * item.count;
            grandTotal += rowTotal;

            let row = document.createElement('div');
            row.className = 'bucket-row';
            row.innerHTML = `<span>${item.name} x${item.count}</span><span>${rowTotal.toLocaleString()} so'm</span>`;
            bucketContainer.appendChild(row);
        });

        document.getElementById('chk-grand-total').innerText = `JAMI: ${grandTotal.toLocaleString()} so'm`;
    }

    // Filter
    function executeClusterFilter(segmentKey, btnNode) {
        document.querySelectorAll('.mini-filter-node').forEach(b => b.classList.remove('active-node'));
        btnNode.classList.add('active-node');

        document.querySelectorAll('.category-cluster').forEach(cluster => {
            if(cluster.getAttribute('data-segment') === segmentKey) {
                cluster.style.display = 'block';
            } else {
                cluster.style.display = 'none';
            }
        });
    }

    // Qidiruv
    function searchCatalogItems() {
        let query = document.getElementById('catalog-searcher').value.toLowerCase();
        document.querySelectorAll('.premium-choco-card').forEach(card => {
            let name = card.getAttribute('data-name').toLowerCase();
            if(name.includes(query)) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // Majburiy maydonlarni va savatni tekshirish
    function verifyAndSendOrder() {
        const nameInput = document.getElementById('client-name');
        const surnameInput = document.getElementById('client-surname');
        const phoneInput = document.getElementById('client-phone');
        const addressInput = document.getElementById('client-address');

        let isValid = true;

        if(!nameInput.value.trim()) {
            nameInput.classList.add('error-active');
            isValid = false;
        }

        if(!surnameInput.value.trim()) {
            surnameInput.classList.add('error-active');
            isValid = false;
        }

        if(!phoneInput.value.trim() || phoneInput.value.trim().length < 7) {
            phoneInput.classList.add('error-active');
            isValid = false;
        }

        if(!addressInput.value.trim()) {
            addressInput.classList.add('error-active');
            isValid = false;
        }

        if(!isValid) {
            showToast("Xatolik!", "Barcha majburiy (*) maydonlarni to'liq to'ldiring!");
            return;
        }

        if(Object.keys(activeCart).length === 0) {
            showToast("Diqqat!", "Savatchaga kamida bitta mahsulot qo'shing!");
            return;
        }

        document.getElementById('sms-modal').style.display = 'flex';
    }

    function confirmOrderSuccess() {
        let code = document.getElementById('sms-code-input').value;
        if(code.length < 4) {
            alert("4 xonali kodni to'liq kiriting!");
            return;
        }
        document.getElementById('sms-modal').style.display = 'none';
        showToast("Muvaffaqiyatli!", "Buyurtma Yangibozor tumani bo'yicha yetkazib berishga qabul qilindi! 🚀");
        
        // Tozalash
        activeCart = {};
        renderReceipt();
        document.querySelectorAll('.premium-choco-card').forEach(c => c.classList.remove('multi-selected'));
        document.getElementById('client-name').value = '';
        document.getElementById('client-surname').value = '';
        document.getElementById('client-phone').value = '';
        document.getElementById('client-address').value = 'Yangibozor tumani';
        
        document.getElementById('chk-fullname').innerText = 'Kiritilmagan';
        document.getElementById('chk-fullname').style.color = 'var(--error)';
        document.getElementById('chk-phone').innerText = 'Kiritilmagan';
        document.getElementById('chk-phone').style.color = 'var(--error)';
        document.getElementById('chk-address').innerText = 'Yangibozor tumani';
        document.getElementById('chk-address').style.color = 'var(--deep-blue)';
        document.getElementById('sms-code-input').value = '';
    }

    function showToast(title, desc) {
        const toast = document.getElementById('toast-notify');
        document.getElementById('toast-title').innerText = title;
        document.getElementById('toast-desc').innerText = desc;
        toast.classList.add('active-toast');
        setTimeout(() => {
            toast.classList.remove('active-toast');
        }, 4000);
    }
</script>

