            <label>Telefon raqam: <span>*</span></label>
            <input type="tel" id="client-phone" placeholder="Masalan: 952846471">
        </div>
        <div class="input-gatekeeper">
            <label>Yetkazib berish manzili: <span>*</span></label>
            <input type="text" id="client-address" value="Yangibozor tumani" placeholder="Manzilni kiriting...">
        </div>

        <div class="pos-paper-receipt">
            <div class="receipt-header-node">
                <div>🧾 SWEET BILL RECEIPT</div>
                <div style="font-size:9px; font-weight:normal; color:#555; margin-top:2px;">TIZIM: CYBER BLUE V5</div>
            </div>
            <div class="receipt-data-row"><span>Mijoz:</span> <span id="chk-fullname" style="color:var(--error); font-weight:bold;">Kiritilmagan</span></div>
            <div class="receipt-data-row"><span>Raqam:</span> <span id="chk-phone" style="color:var(--error); font-weight:bold;">Kiritilmagan</span></div>
            <div class="receipt-data-row"><span>Manzil:</span> <span id="chk-address" style="color:var(--deep-blue); font-weight:bold;">Yangibozor tumani</span></div>
            <div style="border-bottom: 1px dashed #000; margin: 8px 0;"></div>
            
            <div class="receipt-items-bucket" id="receipt-basket-list">
                <div style="color:#777; text-align:center; font-size:11px; margin-top:20px;">Shirinlik tanlanmadi</div>
            </div>
            
            <div class="receipt-grand-total" id="chk-grand-total">JAMI: 0 so'm</div>
        </div>

        <button class="order-dispatch-btn" onclick="verifyAndSendOrder()">Buyurtma berish</button>
    </div>

    <div class="catalog-display-side">
        <div class="filter-control-deck">
            <div class="deck-search-box">
                <input type="text" id="catalog-searcher" placeholder="Shirinlik yoki kofe nomini yozib qidiring..." oninput="searchCatalogItems()">
            </div>
            <button class="mini-filter-node active-node" onclick="executeClusterFilter('cakes', this)">Tortlar (14)</button>
            <button class="mini-filter-node" onclick="executeClusterFilter('cold-sweets', this)">Desertlar (13)</button>
            <button class="mini-filter-node" onclick="executeClusterFilter('sweet-drinks', this)">Ichimliklar & Kofe (22)</button>
        </div>

        <div class="vault-scroll-grid">
            
            <div class="category-cluster" data-segment="cakes">
                <div class="cluster-title-bar">Eksklyuziv Tortlar va Pishiriqlar</div>
                <div class="item-stack-vertical">
                    <div class="premium-choco-card" data-id="ck1" data-name="Medoviy Klassik" data-price="18000" onclick="toggleMultiSelect(this)">
                        <div class="card-left-payload"><div class="card-graphic-icon">🍰</div><div class="card-meta-text"><div class="item-header-name">Medoviy Klassik</div><div class="item-snippet-desc">Asalli yumshoq va mayin korj qatlamlari</div></div></div>
                        <div class="card-price-payload">18,000 so'm</div>
                    </div>
                    <div class="premium-choco-card" data-id="ck2" data-name="Chizkeyk Nyu-York" data-price="24000" onclick="toggleMultiSelect(this)">
                        <div class="card-left-payload"><div class="card-graphic-icon">🧀</div><div class="card-meta-text"><div class="item-header-name">Chizkeyk Nyu-York</div><div class="item-snippet-desc">Tvorogli qaymoqli pishloq va qumloq asos</div></div></div>
                        <div class="card-price-payload">24,000 so'm</div>
                    </div>
                    <div class="premium-choco-card" data-id="ck3" data-name="Snickers Luxury Cake" data-price="22000" onclick="toggleMultiSelect(this)">
                        <div class="card-left-payload"><div class="card-graphic-icon">🥜</div><div class="card-meta-text"><div class="item-header-name">Snickers Luxury Cake</div><div class="item-snippet-desc">Yong'oq, quyuq karamel va sutli shokolad</div></div></div>
                        <div class="card-price-payload">22,000 so'm</div>
                    </div>
                    <div class="premium-choco-card" data-id="ck4" data-name="Cinnabon Original" data-price="17000" onclick="toggleMultiSelect(this)">
                        <div class="card-left-payload"><div class="card-graphic-icon">🧁</div><div class="card-meta-text"><div class="item-header-name">Cinnabon Original</div><div class="item-snippet-desc">Issiq dolchinli va shirin oq krem quyilgan bulochka</div></div></div>
                        <div class="card-price-payload">17,000 so'm</div>
                    </div>
