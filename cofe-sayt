<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mega Sweet & Drink Empire | Cyber Blue</title>
    <style>
        :root {
            --cyber-blue: #00b4d8;
            --deep-blue: #0077b6;
            --neon-glow: #90e0ef;
            --bg-absolute: #03045e;
            --panel-bg: rgba(2, 6, 23, 0.96);
            --card-bg: #0b132b;
            --card-hover: #1c2541;
            --card-selected: #0077b6;
            --text-light: #f1f5f9;
            --text-dim: #94a3b8;
            --neon-gold: #caf0f8;
            --success: #4ade80;
            --error: #f87171;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: var(--bg-absolute);
            color: var(--text-light);
            font-family: 'Segoe UI', system-ui, sans-serif;
            overflow: hidden;
        }

        .mega-app-container {
            display: flex;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, #070a52 0%, #010214 100%);
        }

        /* CHAP PANEL: KASSA TERMINALI VA SAVATCHA */
        .billing-terminal-side {
            width: 34%;
            min-width: 390px;
            background: var(--panel-bg);
            border-right: 2px solid var(--cyber-blue);
            padding: 25px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            box-shadow: 15px 0 45px rgba(0,0,0,0.7);
            z-index: 10;
            backdrop-filter: blur(25px);
        }

        .lounge-brand h1 {
            margin: 0;
            text-align: center;
            color: var(--cyber-blue);
            font-size: 24px;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(0, 180, 216, 0.3);
        }

        .live-clock-badge {
            margin: 6px auto;
            font-size: 14px;
            font-family: monospace;
            color: #fff;
            background: rgba(0,0,0,0.5);
            padding: 4px 14px;
            border-radius: 30px;
            display: table;
            border: 1px solid var(--cyber-blue);
        }

        .input-gatekeeper {
            margin-bottom: 12px;
        }

        .input-gatekeeper label {
            display: block;
            font-size: 11px;
            color: var(--text-dim);
            text-transform: uppercase;
            margin-bottom: 4px;
            letter-spacing: 1px;
        }

        .input-gatekeeper label span {
            color: var(--error);
            font-weight: bold;
        }

        .input-gatekeeper input {
            width: 100%;
            padding: 11px;
            background: #020617;
            border: 1px solid #1e293b;
            border-radius: 7px;
            color: #fff;
            font-size: 14px;
            outline: none;
            box-sizing: border-box;
        }

        .input-gatekeeper input.error-active {
            border-color: var(--error);
            background: #451a1a;
        }

        /* Professional Kassa Cheki */
        .pos-paper-receipt {
            flex: 1;
            background: #fff;
            color: #000;
            border-radius: 12px;
            padding: 18px;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            flex-direction: column;
            box-shadow: inset 0 0 25px rgba(0,0,0,0.2);
            overflow-y: auto;
            margin-bottom: 12px;
        }

        .receipt-header-node {
            text-align: center;
            border-bottom: 2px dashed #000;
            padding-bottom: 6px;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .receipt-items-bucket {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 10px;
        }

        .bucket-row {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin: 4px 0;
            border-bottom: 1px dotted #ccc;
            padding-bottom: 2px;
        }

        .receipt-data-row {
            display: flex;
            justify-content: space-between;
            margin: 4px 0;
            font-size: 13px;
        }

        .receipt-grand-total {
            font-weight: bold;
            font-size: 17px;
            border-top: 2px solid #000;
            padding-top: 8px;
            margin-top: auto;
        }

        .order-dispatch-btn {
            width: 100%;
            background: var(--deep-blue);
            color: #fff;
            border: none;
            padding: 15px;
            font-size: 15px;
            font-weight: bold;
            text-transform: uppercase;
            border-radius: 8px;
            cursor: pointer;
            letter-spacing: 1px;
            transition: 0.3s;
        }

        .order-dispatch-btn:hover {
            background: var(--cyber-blue);
            color: #000;
            box-shadow: 0 0 20px var(--cyber-blue);
        }

        /* O'NG TOMON: KATALOG VA FILTRLAR */
        .catalog-display-side {
            width: 66%;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .filter-control-deck {
            padding: 20px 40px;
            background: rgba(2, 6, 23, 0.95);
            border-bottom: 1px solid #1e293b;
            display: flex;
            gap: 12px;
            align-items: center;
            overflow-x: auto;
        }

        .deck-search-box {
            flex: 1;
            min-width: 200px;
        }

        .deck-search-box input {
            width: 100%;
            padding: 11px 20px;
            background: #020617;
            border: 1px solid #1e293b;
            border-radius: 25px;
            color: #fff;
            outline: none;
        }

        .mini-filter-node {
            background: #020617;
            border: 1px solid #1e293b;
            color: var(--text-dim);
            padding: 8px 16px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .mini-filter-node.active-node, .mini-filter-node:hover {
            border-color: var(--cyber-blue);
            color: #fff;
            background: var(--card-bg);
        }

        /* Skrol hududi */
        .vault-scroll-grid {
            flex: 1;
            overflow-y: auto;
            padding: 25px 40px;
        }

        .category-cluster {
            margin-bottom: 30px;
        }

        .cluster-title-bar {
            font-size: 17px;
            color: var(--cyber-blue);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #1e293b;
            padding-bottom: 6px;
            margin-bottom: 12px;
        }

        .item-stack-vertical {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .premium-choco-card {
            background: var(--card-bg);
            border: 1px solid #1e293b;
            border-radius: 10px;
            padding: 14px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: 0.2s;
        }

        .premium-choco-card:hover {
            background: var(--card-hover);
            border-color: var(--cyber-blue);
        }

        .premium-choco-card.multi-selected {
            background: var(--card-selected);
            border-color: var(--neon-glow);
            box-shadow: inset 0 0 10px rgba(0, 180, 216, 0.2);
        }

        .card-left-payload {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .card-graphic-icon {
            font-size: 22px;
            background: #020617;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            border: 1px solid #1e293b;
        }

        .card-meta-text .item-header-name {
            font-size: 16px;
            font-weight: bold;
            color: #fff;
        }

        .card-meta-text .item-snippet-desc {
            font-size: 12px;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .card-price-payload {
            color: var(--neon-glow);
            font-weight: bold;
            font-size: 15px;
        }

        .system-credits-footer {
            background: #010214;
            padding: 15px;
            text-align: center;
            font-size: 12px;
            color: var(--text-dim);
            border-top: 1px solid #0b132b;
        }

        .system-credits-footer a {
            color: var(--cyber-blue);
            text-decoration: none;
            font-weight: bold;
        }

        /* SMS MODAL */
        .secure-modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .sms-center-panel {
            background: #fff;
            color: #000;
            width: 350px;
            border-radius: 12px;
            padding: 25px;
            text-align: center;
        }

        .sms-center-panel input {
            width: 130px;
            padding: 10px;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            border: 2px solid var(--deep-blue);
            border-radius: 6px;
            margin: 15px 0;
            outline: none;
        }

        /* TOAST BILDIRISHNOMA */
        .toast-slide-notification {
            position: fixed;
            top: 25px;
            right: -450px;
            width: 340px;
            background: #0f2d3a;
            border-left: 6px solid var(--cyber-blue);
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            gap: 15px;
            transition: right 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 9999;
        }

        .toast-slide-notification.active-toast {
            right: 25px;
        }
    </style>
</head>
<body>

<div class="mega-app-container">
    
    <div class="billing-terminal-side">
