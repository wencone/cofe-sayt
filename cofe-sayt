<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mega Sweet & Drink Empire | Cyber Blue</title>
    <style>
        :root {
            --cyber-blue: #00b4d8;
            --deep-blue: #0077b6;
            --neon-glow: #90e0ef;
            --bg-absolute: #03045e;
            --panel-bg: rgba(2, 6, 23, 0.96);
            --card-bg: #0b132b;
            --card-hover: #1c2541;
            --card-selected: #0077b6;
            --text-light: #f1f5f9;
            --text-dim: #94a3b8;
            --neon-gold: #caf0f8;
            --success: #4ade80;
            --error: #f87171;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: var(--bg-absolute);
            color: var(--text-light);
            font-family: 'Segoe UI', system-ui, sans-serif;
            overflow: hidden;
        }

        .mega-app-container {
            display: flex;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, #070a52 0%, #010214 100%);
        }

        /* CHAP PANEL: KASSA TERMINALI VA SAVATCHA */
        .billing-terminal-side {
            width: 34%;
            min-width: 390px;
            background: var(--panel-bg);
            border-right: 2px solid var(--cyber-blue);
            padding: 25px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            box-shadow: 15px 0 45px rgba(0,0,0,0.7);
            z-index: 10;
            backdrop-filter: blur(25px);
        }

        .lounge-brand h1 {
            margin: 0;
            text-align: center;
            color: var(--cyber-blue);
            font-size: 24px;
            text-transform: uppercase;
            letter-spacing: 2px;
            animation: cyberPulse 3s infinite alternate;
        }

        @keyframes cyberPulse {
            0% { text-shadow: 0 0 10px rgba(0, 180, 216, 0.4); }
            100% { text-shadow: 0 0 25px rgba(144, 224, 239, 0.9), 0 0 5px #fff; }
        }

        .live-clock-badge {
            margin: 6px auto;
            font-size: 14px;
            font-family: monospace;
            color: #fff;
            background: rgba(0,0,0,0.5);
            padding: 4px 14px;
            border-radius: 30px;
            display: table;
            border: 1px solid var(--cyber-blue);
            box-shadow: 0 0 8px rgba(0, 180, 216, 0.3);
        }

        .input-gatekeeper {
            margin-bottom: 10px;
        }

        .input-gatekeeper label {
            display: block;
            font-size: 11px;
            color: var(--text-dim);
            text-transform: uppercase;
            margin-bottom: 4px;
            letter-spacing: 1px;
        }

        .input-gatekeeper label span {
            color: var(--error);
            font-weight: bold;
        }

        .input-gatekeeper input {
            width: 100%;
            padding: 10px;
            background: #020617;
            border: 1px solid #1e293b;
            border-radius: 7px;
            color: #fff;
            font-size: 13.5px;
            outline: none;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .input-gatekeeper input:focus {
            border-color: var(--cyber-blue);
            box-shadow: 0 0 12px rgba(0, 180, 216, 0.5);
        }

        .input-gatekeeper input.error-active {
            border-color: var(--error) !important;
            background: #451a1a !important;
            animation: shake 0.4s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }

        /* Professional Kassa Cheki */
        .pos-paper-receipt {
            flex: 1;
            background: #fff;
            color: #000;
            border-radius: 12px;
            padding: 16px;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            flex-direction: column;
            box-shadow: inset 0 0 25px rgba(0,0,0,0.2), 0 8px 20px rgba(0,0,0,0.4);
            overflow-y: auto;
            margin-bottom: 12px;
            transition: transform 0.3s ease;
        }

        .pos-paper-receipt:hover {
            transform: scale(1.01);
        }

        .receipt-header-node {
            text-align: center;
            border-bottom: 2px dashed #000;
            padding-bottom: 6px;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .receipt-items-bucket {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 10px;
        }

        .bucket-row {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin: 5px 0;
            border-bottom: 1px dotted #ccc;
            padding-bottom: 3px;
            animation: fadeInRow 0.3s ease-in-out;
        }

        @keyframes fadeInRow {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .receipt-data-row {
            display: flex;
            justify-content: space-between;
            margin: 3px 0;
            font-size: 12.5px;
        }

        .receipt-grand-total {
            font-weight: bold;
            font-size: 17px;
            border-top: 2px solid #000;
            padding-top: 8px;
            margin-top: auto;
        }

        .order-dispatch-btn {
            width: 100%;
            background: var(--deep-blue);
            color: #fff;
            border: none;
            padding: 15px;
            font-size: 15px;
            font-weight: bold;
            text-transform: uppercase;
            border-radius: 8px;
            cursor: pointer;
            letter-spacing: 1px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 4px 15px rgba(0, 119, 182, 0.4);
        }

        .order-dispatch-btn:hover {
            background: var(--cyber-blue);
            color: #000;
            box-shadow: 0 0 25px var(--cyber-blue);
            transform: translateY(-2px);
        }

        .order-dispatch-btn:active {
            transform: translateY(1px);
        }

        /* O'NG TOMON: KATALOG VA FILTRLAR */
        .catalog-display-side {
            width: 66%;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .filter-control-deck {
            padding: 20px 40px;
            background: rgba(2, 6, 23, 0.95);
            border-bottom: 1px solid #1e293b;
            display: flex;
            gap: 12px;
            align-items: center;
            overflow-x: auto;
        }

        .deck-search-box {
            flex: 1;
            min-width: 200px;
        }

        .deck-search-box input {
            width: 100%;
            padding: 11px 20px;
            background: #020617;
            border: 1px solid #1e293b;
            border-radius: 25px;
            color: #fff;
            outline: none;
            transition: 0.3s;
        }

        .deck-search-box input:focus {
            border-color: var(--cyber-blue);
            box-shadow: 0 0 15px rgba(0, 180, 216, 0.3);
        }

        .mini-filter-node {
            background: #020617;
            border: 1px solid #1e293b;
            color: var(--text-dim);
            padding: 8px 16px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            transition: all 0.3s ease;
        }

        .mini-filter-node.active-node, .mini-filter-node:hover {
            border-color: var(--cyber-blue);
            color: #fff;
            background: var(--card-bg);
            box-shadow: 0 0 10px rgba(0, 180, 216, 0.3);
        }

        /* Skrol hududi */
        .vault-scroll-grid {
            flex: 1;
            overflow-y: auto;
            padding: 25px 40px;
        }

        .category-cluster {
            margin-bottom: 30px;
            animation: fadeIn 0.4s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .cluster-title-bar {
            font-size: 17px;
            color: var(--cyber-blue);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #1e293b;
            padding-bottom: 6px;
            margin-bottom: 12px;
        }

        .item-stack-vertical {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .premium-choco-card {
            background: var(--card-bg);
            border: 1px solid #1e293b;
            border-radius: 10px;
            padding: 14px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .premium-choco-card:hover {
            background: var(--card-hover);
            border-color: var(--cyber-blue);
            transform: translateX(6px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
        }

        .premium-choco-card.multi-selected {
            background: var(--card-selected);
            border-color: var(--neon-glow);
            box-shadow: 0 0 18px rgba(0, 180, 216, 0.5), inset 0 0 10px rgba(255, 255, 255, 0.2);
            transform: scale(1.01);
        }

        .card-left-payload {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .card-graphic-icon {
            font-size: 22px;
            background: #020617;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            border: 1px solid #1e293b;
            transition: transform 0.3s ease;
        }

        .premium-choco-card:hover .card-graphic-icon {
            transform: rotate(10deg) scale(1.1);
        }

        .card-meta-text .item-header-name {
            font-size: 16px;
            font-weight: bold;
            color: #fff;
        }

        .card-meta-text .item-snippet-desc {
            font-size: 12px;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .card-price-payload {
            color: var(--neon-glow);
            font-weight: bold;
            font-size: 15px;
        }

        /* SMS MODAL */
        .secure-modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s ease;
        }

        .sms-center-panel {
            background: #fff;
            color: #000;
            width: 350px;
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            animation: popUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes popUp {
            from { transform: scale(0.8); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .sms-center-panel input {
            width: 140px;
            padding: 10px;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            border: 2px solid var(--deep-blue);
            border-radius: 6px;
            margin: 15px 0;
            outline: none;
            letter-spacing: 4px;
        }

        /* TOAST BILDIRISHNOMA */
        .toast-slide-notification {
            position: fixed;
            top: 25px;
            right: -450px;
            width: 340px;
            background: #0f2d3a;
            border-left: 6px solid var(--cyber-blue);
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            gap: 15px;
            transition: right 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 9999;
        }

        .toast-slide-notification.active-toast {
            right: 25px;
        }
    </style>
</head>
<body>

<div class="mega-app-container">
    
    <div class="billing-terminal-side">
        <div class="lounge-brand">
            <h1>Sweet Empire</h1>
            <div class="live-clock-badge" id="terminal-clock">00:00:00</div>
        </div>

        <div class="input-gatekeeper">
            <label>Mijoz ismi: <span>*</span></label>
