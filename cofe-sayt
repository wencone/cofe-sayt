            </div>

            <div class="category-cluster" data-segment="cold-sweets" style="display: none;">
                <div class="cluster-title-bar">Muzqaymoq va Nozik Desertlar</div>
                <div class="item-stack-vertical">
                    <div class="premium-choco-card" data-id="cs1" data-name="Plombir Sharshara" data-price="9000" onclick="toggleMultiSelect(this)">
                        <div class="card-left-payload"><div class="card-graphic-icon">🍦</div><div class="card-meta-text"><div class="item-header-name">Plombir Sharshara</div><div class="item-snippet-desc">Klassik qaymoqli vafli stakandagi muzqaymoq</div></div></div>
                        <div class="card-price-payload">9,000 so'm</div>
                    </div>
                    <div class="premium-choco-card" data-id="cs2" data-name="Tiramisu Elegant" data-price="25000" onclick="toggleMultiSelect(this)">
