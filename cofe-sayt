<div class="secure-modal-overlay" id="sms-modal">
    <div class="sms-center-panel">
        <h3>SMS Tasdiqlash</h3>
        <p>Telefon raqamiga yuborilgan 4 xonali kodni kiriting:</p>
        <input type="text" id="sms-code-input" maxlength="4" placeholder="----">
        <br>
        <button class="order-dispatch-btn" onclick="confirmOrderSuccess()">Tasdiqlash</button>
    </div>
